<!DOCTYPE html>
<html lang="en">

<head>
    <title>Library Management Report</title>
    <style>
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            margin: 30px 50px;
            color: #333;
        }

        .header {
            text-align: center;
            font-size: 26px;
            font-weight: bold;
            color: #2c3e50;
            margin-bottom: 5px;
        }

        .sub-header {
            text-align: center;
            font-size: 13px;
            color: #7f8c8d;
            margin-bottom: 30px;
        }

        h3 {
            color: #2c3e50;
            border-bottom: 2px solid #3498db;
            padding-bottom: 5px;
            margin-top: 30px;
        }

        .info-table,
        .stats-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        .info-table td {
            padding: 10px 12px;
            border: 1px solid #ddd;
        }

        .info-table td:first-child {
            background-color: #f7f9fc;
            font-weight: bold;
            width: 35%;
            color: #555;
        }

        .stats-table th,
        .stats-table td {
            padding: 12px 15px;
            border: 1px solid #ddd;
            text-align: center;
        }

        .stats-table th {
            background-color: #3498db;
            color: #fff;
            font-weight: bold;
        }

        .stats-table td {
            font-size: 22px;
            font-weight: bold;
            color: #2c3e50;
        }

        .footer {
            text-align: center;
            margin-top: 40px;
            font-size: 12px;
            color: #95a5a6;
        }
    </style>
</head>

<body>

<div class="header">ReadQuest Library Management Report</div>
<div class="sub-header">Generated on: ${generatedAt}</div>

<!-- Generated By -->
<h3>Report Generated By</h3>
<table class="info-table">
    <tr>
        <td>Name</td>
        <td>${userName}</td>
    </tr>
    <tr>
        <td>Email</td>
        <td>${userEmail}</td>
    </tr>
    <tr>
        <td>Role</td>
        <td>${userRole}</td>
    </tr>
    <tr>
        <td>User ID</td>
        <td>${userId}</td>
    </tr>
</table>

<!-- System Statistics -->
<h3>System Statistics</h3>
<table class="stats-table">
    <tr>
        <th>Total Transactions</th>
        <th>Total Users</th>
        <th>Total Books</th>
    </tr>
    <tr>
        <td>${totalTransactions}</td>
        <td>${totalUsers}</td>
        <td>${totalBooks}</td>
    </tr>
</table>

<div class="footer">
    <p>This report was automatically generated by the ReadQuest Library Management System.</p>
</div>

</body>

</html>
